FROM debian:trixie-slim

RUN apt -y install --update \
  bash \
  git \
  tar \
  vim-tiny \
  libzstd1 libzstd-dev \
  gzip \
  curl \
  wget \
  xz-utils \
  jq \
  perl \
  build-essential \
  openssl libssl-dev \
  libreadline-dev \
  zlib1g zlib1g-dev \
  libffi-dev \
  libyaml-0-2 libyaml-dev \
  nodejs \
  && ln -vs vim.tiny /usr/bin/vim \
  && rm -vrf /var/lib/apt/lists/*

COPY install_rubies.sh /run/install_rubies.sh

# generated by the Makefile, by reading the CI config
COPY tmp/ruby-versions.txt /run/ruby-versions.txt

# /opt/rubies/current is a symlink to the selected ruby.
# Isolate all bundler state to the currently-selected
# ruby version.
ENV BUNDLE_USER_HOME=/opt/rubies/current/bundle

# all bundler commands are run as root
ENV BUNDLE_SILENCE_ROOT_WARNING=true

# set the PATH to follow the current symlink
ENV PATH=/opt/rubies/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# installs all the ruby versions from ruby-versions.txt at /opt/rubies/$VERSION
# and installs a script at /opt/rubies/VERSION/activate to symlink that version
# in as /opt/rubies/current. By default the last ruby in the list is symlinked
# at /opt/rubies/current, but a job intending to run on a specific ruby version
# should run /opt/rubies/$VERSION/activate, where $VERSION is the entry in
# the `ruby-versions` variable in .forgejo/workflows/ruby.yml.
RUN /run/install_rubies.sh

# copy in the three things needed for dependencies:
# * Gemfile
# * rouge.gemspec (for officially declared dependencies)
# * lib/rouge/version.rb (loaded by rouge.gemspec)
COPY tmp/rouge.gemspec tmp/Gemfile /run
COPY tmp/lib/rouge/version.rb /run/lib/rouge/version.rb

# The default BUNDLE_PATH will be changing in Bundler 5 to be in your personal
# your personal home directory, which we *definitely* do not want, since we
# want to isolate gems by ruby version (extensions linking to the wrong libruby
# would be very bad actually). So all gems from the bundle are installed to
# this path, which is symlinked to /opt/rubies/$VERSION/bundle/gems.
ENV BUNDLE_PATH=/opt/rubies/current/bundle/gems

# Install the gems from the bundle for each ruby. Note there is no Gemfile.lock
# present, so Bundler will grab the most recent compatible versions of gems at
# image build time.
#
# However, note that *the job must still also run bundle install*, since pull
# requests may add or remove gems, and dependencies may update. We will need
# to rebuild this image from time to time (at least every release) to avoid
# drift and keep CI runtimes low.
COPY install_gems.sh /run/install_gems.sh
RUN /run/install_gems.sh
